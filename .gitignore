*~

# Private keys and certificates (never commit; see backend/certs and frontend/certs)
*.pem
*.key
*.crt
*.p12
*.pfx
/backend/netfree-ca.pem
/backend/netfree-sign-root.crt

# Personal webcam/gaze diagnostic exports (contain facial measurements)
screen-calibration-data*.json
live-gaze-diagnostic*.json
screen-attention-diagnostic*.json
webgazer-gaze-experiment*.json

# Playwright end-to-end artifacts (generated test video, traces, reports)
frontend/e2e/.generated/
frontend/test-results/
frontend/playwright-report/

# Uploaded lesson videos (local development storage)
backend/storage/

# Generated ONNX Runtime Web assets (copied by scripts/copy-mediapipe-assets.mjs)
frontend/public/ort/
