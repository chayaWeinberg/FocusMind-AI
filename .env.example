# Copy to .env (project root) and change the CHANGE_ME values.
# .env is ignored by Git — never commit real secrets.

# MongoDB credentials — must match docker-compose.yml MONGO_INITDB_ROOT_* values
MONGO_ROOT_USER=focusmind_user
MONGO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION
MONGO_DB_NAME=focusmind_db
# Used when the backend runs locally (outside Docker). Compose overrides it
# with hostname "mongo".
MONGO_URI=mongodb://focusmind_user:CHANGE_ME_IN_PRODUCTION@localhost:27017/focusmind_db?authSource=admin
# Fail fast (milliseconds) when MongoDB is unreachable.
MONGO_TIMEOUT_MS=5000

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
BCRYPT_ROUNDS=12
ACCESS_TOKEN_TTL_MINUTES=30

# Backend CORS — must be a JSON array (pydantic-settings format).
# Only needed when the frontend calls the API from another origin; with the
# Vite dev proxy (default) requests are same-origin.
CORS_ORIGINS=["http://localhost:3000"]
# Production example:
# CORS_ORIGINS=["https://focusmind.example.com"]

# Environment: development | production (production = Secure cookies, no /docs)
ENV=development

# Uploaded lesson videos (MP4 / WebM / Ogg, detected from the file content).
# Local default: backend/storage/videos (ignored by Git). Docker Compose uses
# the persistent volume "video_data" mounted at /data/videos.
# VIDEO_STORAGE_DIR=storage/videos
MAX_VIDEO_UPLOAD_BYTES=1073741824
USER_VIDEO_QUOTA_BYTES=5368709120

# Seed the example catalog (Python / SQL / AI) on startup. Idempotent.
# Leave false in production unless you really want the examples there.
# Manual alternative: cd backend && python -m app.seed
SEED_CATALOG=false

# Learning data retention: delete learning sessions and attention segments
# older than N days on startup. 0 = keep (default). Learners can delete their
# own data any time on the "פרטיות ונתונים" page.
ATTENTION_RETENTION_DAYS=0

# ReplayAI rules (seconds unless noted; defaults shown). See docs/replayai.md.
# REPLAY_SUSTAINED_OFF_SCREEN_SECONDS=4
# REPLAY_GLANCE_SECONDS=1
# REPLAY_REPEATED_COUNT=3
# REPLAY_REPEATED_WINDOW_SECONDS=30
# REPLAY_FACE_ABSENT_SECONDS=5
# REPLAY_INTERRUPTION_COUNT=3
# REPLAY_INTERRUPTION_WINDOW_SECONDS=60
# REPLAY_CONTEXT_BEFORE_SECONDS=5
# REPLAY_CONTEXT_AFTER_SECONDS=3
# REPLAY_MERGE_GAP_SECONDS=5

# Frontend (read from frontend/.env by Vite, not from this file):
#   VITE_API_URL=               empty = same-origin /api through the Vite proxy
#   VITE_API_PROXY_TARGET=http://localhost:8000   where the dev proxy forwards /api
