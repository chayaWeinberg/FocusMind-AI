# FocusMind AI — production settings (template). Copy to .env.production and
# replace every placeholder. Never commit the real file.

# --- Required ---------------------------------------------------------------------
# At least 32 random bytes, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<replace-with-a-long-random-secret>

# Google Cloud Run + MongoDB Atlas: the Atlas connection string (mongodb+srv://...).
MONGO_URI=mongodb+srv://<atlas-user>:<atlas-password>@<cluster-host>/?retryWrites=true&w=majority&appName=focusmind
MONGO_DB_NAME=focusmind

# docker-compose.prod.yml only (a self-hosted MongoDB container instead of Atlas):
MONGO_ROOT_USER=<replace-mongo-admin-user>
MONGO_ROOT_PASSWORD=<replace-mongo-admin-password>

# --- Defaults that are already right in the production image ----------------------
# Secure cookies, no /docs
ENV=production
# catalog + demonstration videos, idempotent
SEED_CATALOG=true
# same origin: client and API share one domain behind the Load Balancer
CORS_ORIGINS=[]
# Cloud Run: mount the Cloud Storage bucket here
VIDEO_STORAGE_DIR=/data/videos
ACCESS_TOKEN_TTL_MINUTES=120

# --- Limits -------------------------------------------------------------------------
# Cloud Run limits an HTTP/1 request body to 32 MiB, so keep uploads below that.
MAX_VIDEO_UPLOAD_BYTES=31457280
USER_VIDEO_QUOTA_BYTES=1073741824
ATTENTION_RETENTION_DAYS=0
