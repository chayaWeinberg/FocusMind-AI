# Files that run inside Linux containers or Git Bash must keep LF line endings,
# also when checked out on Windows (core.autocrlf=true).
*.sh            text eol=lf
*.conf          text eol=lf
Dockerfile*     text eol=lf
*.yml           text eol=lf
.dockerignore   text eol=lf
.gcloudignore   text eol=lf
